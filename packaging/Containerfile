# Build environment for the portable AppImage binary: Ubuntu 22.04 (old glibc, so the binary runs on most distros).
# Base image pinned by digest. apt package versions are recorded by the build script, not pinned.
FROM docker.io/library/ubuntu@sha256:45e9ddc6895604674618a409ca9f73d301da8fdb75fe330e8e9a27b3b219e4ad
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update \
 && apt-get install -y --no-install-recommends build-essential pkg-config libwebkit2gtk-4.1-dev libgtk-3-dev \
      libsoup-3.0-dev librsvg2-dev libssl-dev ca-certificates file \
 && rm -rf /var/lib/apt/lists/*
